{
  "name": "site-audit-tool",
  "version": "1.0.0",
  "description": "Automated website audit tool with performance, SEO, accessibility, and conversion checks",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "audit",
    "lighthouse",
    "seo",
    "performance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "lighthouse": "^11.4.0",
    "chrome-launcher": "^1.0.0",
    "cheerio": "^1.0.0-rc.12",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
